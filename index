const stepLayer=E('g');svg.append(stepLayer);D.steps.forEach(s=>{let g=E('g',{class:'step',tabindex:'0','data-id':s.id});let team=D.teams.find(t=>t.name===s.team);let sh=s.shape==='ellipse'?E('ellipse',{cx:s.x+s.w/2,cy:s.y+s.h/2,rx:s.w/2,ry:s.h/2}):E('rect',{x:s.x,y:s.y,width:s.w,height:s.h,rx:8});Object.entries({fill:'#fff',stroke:team.color,'stroke-width':2}).forEach(([k,v])=>sh.setAttribute(k,v));g.append(sh);let words=s.label.split(' '),lines=[],line='';words.forEach(w=>{if((line+' '+w).length>22){lines.push(line);line=w}else line=(line+' '+w).trim()});if(line)lines.push(line);lines.slice(0,4).forEach((l,i)=>g.append(E('text',{x:s.x+s.w/2,y:s.y+s.h/2+(i-(Math.min(lines.length,4)-1)/2)*13,'text-anchor':'middle','font-size':'10.5'},l)));g.addEventListener('click',()=>selectStep(s.id));g.addEventListener('keydown',e=>{if(e.key==='Enter')selectStep(s.id)});stepLayer.append(g);elById[s.id]=g});
function redraw(){let team=document.getElementById('team').value,hide=document.getElementById('hideOthers').checked,q=document.getElementById('search').value.toLowerCase(),heat=document.getElementById('heat').checked;D.steps.forEach(s=>{let active=team==='all'||s.team===team;let match=!q||(s.label+' '+s.team+' '+s.phase).toLowerCase().includes(q);let g=elById[s.id];g.style.opacity=match?(active?1:(hide?0:.12)):0.05;g.style.pointerEvents=(match&&(!hide||active))?'auto':'none';let shape=g.firstChild;let ps=pains.filter(p=>p.stepId===s.id);shape.setAttribute('fill',heat&&ps.length?severityColor(Math.max(...ps.map(p=>+p.severity))):'#fff');shape.setAttribute('stroke-width',selected===s.id?'5':(ps.length?'3':'2'));});[...edgeLayer.children].forEach(e=>{let a=byId[e.dataset.source],b=byId[e.dataset.target],active=team==='all'||a.team===team||b.team===team;e.style.opacity=active?.75:.06;e.style.display=(hide&&!active)?'none':''});updateSummary()}
function severityColor(n){return ['','#fff4cc','#ffe08a','#ffb85c','#f8785b','#d92d20'][n]}
function selectStep(id){selected=id;let s=byId[id];document.getElementById('blank').classList.add('hidden');document.getElementById('details').classList.remove('hidden');stepTitle.textContent=s.label;stepTeam.textContent=s.team;stepPhase.textContent=s.phase;let incoming=D.edges.filter(e=>e.target===id).length,outgoing=D.edges.filter(e=>e.source===id).length;stepLinks.textContent=`${incoming} incoming, ${outgoing} outgoing`;renderPains();redraw()}
function renderPains(){let list=pains.filter(p=>p.stepId===selected);painCount.textContent=list.length;painList.innerHTML='';list.forEach(p=>{let li=document.createElement('li');li.style.borderLeftColor=severityColor(+p.severity);li.innerHTML=`<b>${esc(p.category)} · Severity ${p.severity}</b><br>${esc(p.description)}<div class="tip">${esc(p.reviewer||'Unassigned')} · ${new Date(p.created).toLocaleString()}</div><button data-id="${p.id}" style="margin-top:5px">Delete</button>`;li.querySelector('button').onclick=()=>{pains=pains.filter(x=>x.id!==p.id);persist();renderPains();redraw()};painList.append(li)})}
function esc(x){return String(x||'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]))}
function persist(){localStorage.setItem('cisPainPoints',JSON.stringify(pains));updateSummary()}
save.onclick=()=>{if(!selected||!desc.value.trim())return alert('Enter a pain-point description.');pains.push({id:crypto.randomUUID?crypto.randomUUID():Date.now().toString(),stepId:selected,step:byId[selected].label,team:byId[selected].team,phase:byId[selected].phase,category:cat.value,severity:sev.value,description:desc.value.trim(),cause:cause.value.trim(),idea:idea.value.trim(),reviewer:reviewer.value.trim(),created:new Date().toISOString()});desc.value=cause.value=idea.value='';persist();renderPains();redraw()};
function teamPath(){let t=team.value;if(t==='all')return [];return D.steps.filter(s=>s.team===t).sort((a,b)=>a.x-b.x||a.y-b.y)}
function movePath(n){let p=teamPath();if(!p.length)return;pathIndex=(pathIndex+n+p.length)%p.length;selectStep(p[pathIndex].id);stepno.textContent=`Step ${pathIndex+1} of ${p.length}`;let s=p[pathIndex];wrap.scrollTo({left:Math.max(0,(s.x*scale)-wrap.clientWidth/2),top:Math.max(0,(s.y*scale)-wrap.clientHeight/2),behavior:'smooth'})}
prev.onclick=()=>movePath(-1);next.onclick=()=>movePath(1);team.onchange=()=>{pathIndex=-1;stepno.textContent=team.value==='all'?'No team path selected':`${teamPath().length} steps`;redraw()};hideOthers.onchange=heat.onchange=redraw;search.oninput=redraw;
let scale=.75;function setZoom(v){scale=v/100;svg.style.transform=`scale(${scale})`;svg.style.width=D.width+'px';svg.style.height=D.height+'px';document.getElementById('diagram').parentElement.style.setProperty('--scaledW',(D.width*scale+30)+'px');zoomVal.textContent=v+'%'}zoom.oninput=()=>setZoom(+zoom.value);fit.onclick=()=>{let v=Math.max(20,Math.min(100,(wrap.clientWidth-30)/D.width*100));zoom.value=v;setZoom(v)};
function download(name,text,type){let a=document.createElement('a');a.href=URL.createObjectURL(new Blob([text],{type}));a.download=name;a.click();URL.revokeObjectURL(a.href)}
exportJson.onclick=()=>download('CIS-pain-points.json',JSON.stringify(pains,null,2),'application/json');exportCsv.onclick=()=>{let cols=['step','team','phase','category','severity','description','cause','idea','reviewer','created'];let out=[cols.join(',')].concat(pains.map(p=>cols.map(c=>'"'+String(p[c]||'').replace(/"/g,'""')+'"').join(','))).join('\\n');download('CIS-pain-points.csv',out,'text/csv')};
importJson.onchange=e=>{let f=e.target.files[0];if(!f)return;let r=new FileReader();r.onload=()=>{try{let x=JSON.parse(r.result);if(!Array.isArray(x))throw 0;pains=x;persist();renderPains();redraw()}catch{alert('The selected file is not a valid pain-point backup.')}};r.readAsText(f)};
function updateSummary(){let max=pains.length?Math.max(...pains.map(p=>+p.severity)):0;summary.innerHTML=`<b>${D.steps.length}</b> steps · <b>${D.edges.length}</b> connections · <b>${pains.length}</b> pain points${max?' · highest severity '+max:''}`}
D.teams.forEach(t=>{let o=document.createElement('option');o.value=o.textContent=t.name;team.append(o);let s=document.createElement('span');s.innerHTML=`<i class="dot" style="background:${t.color}"></i>${t.name}`;legend.append(s)});setZoom(75);redraw();
</script></body></html>
