<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>CIS Process Review Workspace</title>
<style>
:root{--navy:#16324f;--blue:#2463a6;--line:#d8e0e8;--bg:#f4f7fa;--danger:#b42318}
*{box-sizing:border-box} body{margin:0;font:14px/1.4 Segoe UI,Arial,sans-serif;color:#172b3a;background:var(--bg)}
header{background:linear-gradient(120deg,#16324f,#2463a6);color:white;padding:16px 22px;display:flex;gap:18px;align-items:center;justify-content:space-between}
header h1{font-size:20px;margin:0} header p{margin:2px 0 0;opacity:.85}
.toolbar{display:flex;flex-wrap:wrap;gap:8px;padding:10px 14px;background:white;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:20}
button,select,input,textarea{font:inherit} button,.filebtn{border:1px solid #aebdcc;background:white;border-radius:6px;padding:7px 10px;cursor:pointer} button:hover,.filebtn:hover{background:#eef5fb} button.primary{background:#2463a6;color:white;border-color:#2463a6}
.search{min-width:230px;padding:7px 9px;border:1px solid #aebdcc;border-radius:6px} .spacer{flex:1} .zoom{display:flex;align-items:center;gap:6px}
.layout{display:grid;grid-template-columns:minmax(0,1fr) 350px;height:calc(100vh - 126px)}
.canvas-wrap{overflow:auto;background:#e8edf2;position:relative} #diagram{transform-origin:0 0;background:white;box-shadow:0 1px 5px #9aa8b6;margin:14px}
aside{background:white;border-left:1px solid var(--line);overflow:auto;padding:16px} aside h2{font-size:18px;margin:0 0 10px} aside h3{font-size:15px;margin:18px 0 8px}
.meta{display:grid;grid-template-columns:80px 1fr;gap:5px} label{font-weight:600;display:block;margin:8px 0 4px} textarea,input[type=text],select.form{width:100%;padding:8px;border:1px solid #aebdcc;border-radius:5px}
textarea{min-height:70px;resize:vertical} .badge{display:inline-block;border-radius:12px;padding:2px 8px;background:#e5edf5;font-size:12px} .count{background:#b42318;color:white}
.empty{color:#607080;padding:28px 8px;text-align:center} .pain-list{margin:0;padding:0;list-style:none} .pain-list li{border:1px solid var(--line);border-left:5px solid #f79009;border-radius:5px;padding:8px;margin:7px 0}
.hidden{display:none!important} .tip{font-size:12px;color:#5b6b78} .legend{display:flex;gap:10px;flex-wrap:wrap} .legend span{display:flex;align-items:center;gap:4px} .dot{width:11px;height:11px;border-radius:50%}
@media(max-width:900px){.layout{grid-template-columns:1fr} aside{position:fixed;right:0;top:0;bottom:0;width:min(360px,95vw);z-index:40;box-shadow:-3px 0 12px #667;background:white}}
</style></head><body>
<header><div><h1>CIS Process Review Workspace</h1><p>Follow a team, inspect handoffs and capture pain points directly against process steps.</p></div><div id="summary"></div></header>
<div class="toolbar">
<select id="team"><option value="all">All teams</option></select>
<label style="font-weight:400;margin:0"><input type="checkbox" id="hideOthers"> Hide other teams</label>
<label style="font-weight:400;margin:0"><input type="checkbox" id="heat"> Pain-point heat map</label>
<input id="search" class="search" placeholder="Search steps, teams or phases">
<button id="prev">◀ Previous</button><button id="next">Next ▶</button>
<span id="stepno" class="badge">No team path selected</span><span class="spacer"></span>
<div class="zoom">Zoom <input id="zoom" type="range" min="35" max="160" value="75"><span id="zoomVal">75%</span></div>
<button id="fit">Fit width</button><button id="exportCsv">Export CSV</button><button id="exportJson">Backup JSON</button><label class="filebtn">Import JSON<input id="importJson" type="file" accept="application/json" hidden></label>
</div>
<div class="layout"><main class="canvas-wrap" id="wrap"><svg id="diagram" xmlns="http://www.w3.org/2000/svg"></svg></main><aside>
<div id="blank" class="empty">Select a process step to review details or add a pain point.</div>
<div id="details" class="hidden"><h2 id="stepTitle"></h2><div class="meta"><b>Team</b><span id="stepTeam"></span><b>Phase</b><span id="stepPhase"></span><b>Connections</b><span id="stepLinks"></span></div>
<h3>Add pain point</h3><label>Category</label><select id="cat" class="form"><option>Bottleneck</option><option>Delay / wait</option><option>Rework</option><option>Handoff issue</option><option>Data quality</option><option>Manual effort</option><option>Control gap</option><option>Unclear ownership</option><option>Other</option></select>
<label>Severity</label><select id="sev" class="form"><option value="1">1 - Low</option><option value="2">2 - Moderate</option><option value="3">3 - Significant</option><option value="4">4 - High</option><option value="5">5 - Critical</option></select>
<label>Description</label><textarea id="desc" placeholder="What happens, how often, and what is the impact?"></textarea><label>Possible cause</label><textarea id="cause" placeholder="Observed or suspected root cause"></textarea><label>Suggested improvement</label><textarea id="idea" placeholder="Potential countermeasure or experiment"></textarea><label>Reviewer / initials</label><input id="reviewer" type="text"><button id="save" class="primary" style="margin-top:10px">Save pain point</button>
<h3>Recorded pain points <span id="painCount" class="badge"></span></h3><ul id="painList" class="pain-list"></ul></div>
<h3>Legend</h3><div id="legend" class="legend"></div><p class="tip">Data is saved locally in this browser. Use Backup JSON for transfer or workshop consolidation.</p>
</aside></div>
